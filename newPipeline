pipeline {     agent any 
 
    stages { 
        stage('Build Docker Image') {             steps { 
                bat 'docker build -t shahid/demobook:v1 .' 
            } 
        } 
 
        stage('Push Docker Image') { 
            steps { 
                withCredentials([usernamePassword(credentialsId: 'dockerhub_credentials', usernameVariable: 'shahid', passwordVariable: 'shahid')]) {                     bat 'docker login -u %USERNAME% -p %PASSWORD%'                     bat 'docker push nehapmca/demobook:v1' 
                } 
            } 
        } 
 
        stage('Run Container') {             steps { 
                bat 'docker run -d -p 8080:80 shahid/demobook:v1' 
            } 
        } 
    } 
} 
 
